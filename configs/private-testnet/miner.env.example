# Operator shell variables for the v2.4.0 private-testnet external miner.
# pulsedag-miner consumes CLI flags, not these variable names directly.
# Source this file from an operator wrapper, then pass the values as flags.
PULSEDAG_MINER_NODE_URL=http://127.0.0.1:8280
PULSEDAG_MINER_ADDRESS=REPLACE_WITH_VALUELESS_PRIVATE_TEST_ADDRESS
PULSEDAG_MINER_THREADS=2
PULSEDAG_MINER_MAX_TRIES=1000000
PULSEDAG_MINER_SLEEP_MS=250
PULSEDAG_MINER_REFRESH_BEFORE_EXPIRY_MS=1000
PULSEDAG_MINER_BACKEND=cpu

# Example:
# pulsedag-miner \
#   --node "$PULSEDAG_MINER_NODE_URL" \
#   --miner-address "$PULSEDAG_MINER_ADDRESS" \
#   --threads "$PULSEDAG_MINER_THREADS" \
#   --max-tries "$PULSEDAG_MINER_MAX_TRIES" \
#   --loop \
#   --sleep-ms "$PULSEDAG_MINER_SLEEP_MS" \
#   --refresh-before-expiry-ms "$PULSEDAG_MINER_REFRESH_BEFORE_EXPIRY_MS" \
#   --backend "$PULSEDAG_MINER_BACKEND"
