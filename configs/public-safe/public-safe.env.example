# v2.4.0 public-safe RPC example
#
# This file is documentation only. It does not authorize public launch.
# Replace deployment-specific persistent paths and network identity only after
# the final v2.4.0 candidate, genesis and bootnodes are frozen.

PULSEDAG_CONFIG_PROFILE=operator
PULSEDAG_API_PROFILE=public_safe

# Recommended when a trusted reverse proxy terminates TLS on the same host.
# A direct public bind requires separately reviewed firewall and TLS ownership.
PULSEDAG_RPC_BIND=127.0.0.1:8080

# Public-safe defaults are repeated explicitly for evidence and review.
PULSEDAG_RPC_REQUEST_BODY_LIMIT_BYTES=131072
PULSEDAG_RPC_RATE_LIMIT_REQUESTS_PER_MINUTE=30
PULSEDAG_RPC_RATE_LIMIT_PER_IP=true
PULSEDAG_RPC_CORS_UNSAFE_ALLOW_WILDCARD_WITH_ADMIN=false

# Empty/omitted means browser cross-origin access is denied.
# Use exact origins only, comma separated. Never use '*'.
# PULSEDAG_RPC_CORS_ALLOWLIST=https://explorer.example,https://status.example

# Public listener must not expose operator/admin control.
PULSEDAG_ADMIN_ENABLED=false
# Do not set PULSEDAG_OPERATOR_AUTH_TOKEN on this listener.

# P2P discovery uses frozen explicit bootnodes and Kademlia. mDNS is not part
# of the v2.4.0 public topology.
PULSEDAG_P2P_ENABLED=true
PULSEDAG_P2P_MODE=libp2p-real
PULSEDAG_P2P_MDNS=false
PULSEDAG_P2P_KADEMLIA=true
# PULSEDAG_P2P_BOOTSTRAP=/ip4/203.0.113.10/tcp/30333,/ip4/203.0.113.11/tcp/30333

# Persistent paths and identity are deployment-specific and must not use /tmp.
PULSEDAG_ROCKSDB_PATH=/var/lib/pulsedag/rocksdb
PULSEDAG_P2P_IDENTITY_KEY=/var/lib/pulsedag/p2p-identity.key

# Public readiness and contracts remain false until separately authorized.
PULSEDAG_PUBLIC_TESTNET_READY=false
PULSEDAG_THIRTY_DAY_PUBLIC_TESTNET_CLOCK_STARTED=false
PULSEDAG_CONTRACTS_ENABLED=false
