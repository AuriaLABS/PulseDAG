# PulseDAG v2.4.0 public-testnet seed candidate profile.
# PRE-GO ONLY. Replace every REPLACE_* value before use and keep launch-control flags false
# until issue #781 records GO_PUBLIC_TESTNET.
PULSEDAG_PUBLIC_TESTNET_ROLE=seed
PULSEDAG_CONFIG_PROFILE=testnet
PULSEDAG_NETWORK_PROFILE=REPLACE_WITH_FINAL_PUBLIC_TESTNET_PROFILE
PULSEDAG_CHAIN_ID=REPLACE_WITH_FINAL_PUBLIC_TESTNET_CHAIN_ID
PULSEDAG_CONSENSUS_MODE=legacy

# Public P2P is allowed; discovery remains explicit and identity must persist across restarts.
PULSEDAG_P2P_ENABLED=true
PULSEDAG_P2P_MODE=libp2p-real
PULSEDAG_P2P_LISTEN=/ip4/0.0.0.0/tcp/30333
PULSEDAG_P2P_BOOTSTRAP=/dns4/seed-2.example.net/tcp/30333/p2p/REPLACE_WITH_SEED_2_PEER_ID
PULSEDAG_P2P_MDNS=false
PULSEDAG_P2P_KADEMLIA=false
PULSEDAG_P2P_IDENTITY_KEY=/var/lib/pulsedag/public-testnet/identity.key
PULSEDAG_PUBLIC_P2P_MULTIADDR=/dns4/seed-1.example.net/tcp/30333/p2p/REPLACE_WITH_THIS_SEED_PEER_ID

# Keep the node RPC listener on loopback and expose only the public-safe surface through
# an explicitly managed TLS reverse proxy/status endpoint.
PULSEDAG_RPC_BIND=127.0.0.1:8080
PULSEDAG_API_PROFILE=public_safe
PULSEDAG_ADMIN_ENABLED=false
PULSEDAG_RPC_REQUEST_BODY_LIMIT_BYTES=131072
PULSEDAG_RPC_RATE_LIMIT_REQUESTS_PER_MINUTE=30
PULSEDAG_RPC_RATE_LIMIT_PER_IP=true
PULSEDAG_RPC_CORS_ALLOWLIST=

PULSEDAG_ROCKSDB_PATH=/var/lib/pulsedag/public-testnet/rocksdb
PULSEDAG_AUTO_REBUILD_ON_START=true
PULSEDAG_PERSIST_SNAPSHOT_ON_START=true
# v2.4 public bootnodes stay archival until a reviewed checkpoint/state-sync path exists.
# This prevents a fresh node from selecting only peers whose retained history no longer
# overlaps genesis/its local selected chain.
PULSEDAG_AUTO_PRUNE_ENABLED=false
PULSEDAG_AUTO_PRUNE_EVERY_BLOCKS=100
PULSEDAG_PRUNE_KEEP_RECENT_BLOCKS=1000
PULSEDAG_PRUNE_REQUIRE_SNAPSHOT=true

# Launch-control guardrails. These remain false during candidate validation/rehearsal.
PULSEDAG_PUBLIC_TESTNET_READY=false
PULSEDAG_THIRTY_DAY_PUBLIC_TESTNET_CLOCK_STARTED=false
PULSEDAG_CONTRACTS_ENABLED=false
