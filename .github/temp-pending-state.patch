+    #[test]
+    fn submission_started_is_reserved_serialized_and_cannot_begin_twice() {
+        let mut journal = WalletPendingJournal::new(network("chain-a")).expect("journal");
+        let selected = [selected("11", 0)];
+        let txid = final_txid("aa");
+        journal
+            .reserve_signed(&txid, address(), &selected)
+            .expect("reserve");
+        journal
+            .mark_submission_started(&txid)
+            .expect("submission started");
+        assert_eq!(
+            journal.entry(&txid).expect("entry").state,
+            WalletPendingState::SubmissionStarted
+        );
+        assert_eq!(journal.reserved_outpoints().len(), 1);
+        let encoded = serde_json::to_value(&journal).expect("serialize");
+        assert_eq!(
+            encoded["entries"][0]["state"],
+            serde_json::Value::String("submission_started".to_string())
+        );
+        assert!(matches!(
+            journal.mark_submission_started(&txid),
+            Err(WalletPendingError::InvalidTransition {
+                current: WalletPendingState::SubmissionStarted,
+                next: WalletPendingState::SubmissionStarted
+            })
+        ));
+    }
