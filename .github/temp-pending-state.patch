+    /// Durably crossing this boundary means a relay submission may follow.
+    /// It is intentionally not idempotent: a second call must fail so a
+    /// restarted caller cannot blindly resubmit an already-started attempt.
+    pub fn mark_submission_started(
+        &mut self,
+        final_txid: &str,
+    ) -> Result<(), WalletPendingError> {
+        self.validate()?;
+        validate_txid(final_txid)?;
+        let entry = self
+            .entries
+            .iter_mut()
+            .find(|entry| entry.final_txid == final_txid)
+            .ok_or_else(|| WalletPendingError::UnknownTransaction(final_txid.to_string()))?;
+        if entry.state != WalletPendingState::Signed {
+            return Err(WalletPendingError::InvalidTransition {
+                current: entry.state,
+                next: WalletPendingState::SubmissionStarted,
+            });
+        }
+        entry.state = WalletPendingState::SubmissionStarted;
+        entry.rejection_code = None;
+        entry.rejection_message = None;
+        self.validate()
+    }
