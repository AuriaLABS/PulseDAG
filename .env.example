# PulseDAG node environment example
# Copy to `.env` and adjust values for your environment.

# Profile defaults: dev | local | private | testnet | operator (alias: staging)
PULSEDAG_CONFIG_PROFILE=testnet

# Core node identity/network
PULSEDAG_CHAIN_ID=pulsedag-testnet
# Loopback by default. All-interfaces binds require PULSEDAG_RPC_UNSAFE_BIND_ANY=true
# or PULSEDAG_API_PROFILE=public_safe.
PULSEDAG_RPC_BIND=127.0.0.1:8080
PULSEDAG_ROCKSDB_PATH=./data/rocksdb

# P2P
PULSEDAG_P2P_ENABLED=true
# Allowed: libp2p-real, libp2p-dev, libp2p, libp2p-skeleton, memory, simulated
PULSEDAG_P2P_MODE=libp2p-real
PULSEDAG_P2P_LISTEN=/ip4/0.0.0.0/tcp/30333
# Comma-separated multiaddr list
PULSEDAG_P2P_BOOTSTRAP=
PULSEDAG_P2P_MDNS=false
PULSEDAG_P2P_KADEMLIA=true

# Optional in-memory/simulated peer list (comma-separated)
PULSEDAG_SIMULATED_PEERS=

# Runtime consensus: legacy | ghostdag_dev
# Protocol identity (separate knob): PULSEDAG_PROTOCOL_CONSENSUS_MODE=legacy|ghostdag_v1
PULSEDAG_CONSENSUS_MODE=legacy
# PULSEDAG_PROTOCOL_CONSENSUS_MODE=legacy

# Startup behavior
PULSEDAG_AUTO_REBUILD_ON_START=true
PULSEDAG_PERSIST_SNAPSHOT_ON_START=true
